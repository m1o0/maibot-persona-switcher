{
  "manifest_version": 2,
  "id": "m1o0.persona-switcher",
  "version": "1.1.1",
  "name": "人设存档与切换",
  "description": "把人设存成存档，随时切换回来，并且到点能自动恢复。支持整套人设、群聊人设、单个聊天流人设三级粒度；切换前自动备份，切换后可一键恢复原状；可选限时生效（如「30 分钟后自动换回」）。全部在 WebUI 页面里点按操作，不用改配置文件。只动人设字段，聊天频率、模型、语音等配置一律不碰。",
  "author": {
    "name": "m1o0",
    "url": "https://github.com/m1o0"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/m1o0/maibot-persona-switcher",
    "homepage": "https://github.com/m1o0/maibot-persona-switcher"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "plugin_type": "data",
  "dependencies": [
    {
      "type": "python_package",
      "name": "tomlkit",
      "version_spec": ">=0.12"
    }
  ],
  "capabilities": [
    "config.get",
    "chat.get_all_streams"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
